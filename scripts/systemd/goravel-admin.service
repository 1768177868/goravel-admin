[Unit]
Description=Goravel Admin Application
After=network.target mysql.service
Requires=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/www/goravel-admin
ExecStart=/www/goravel-admin/main
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goravel-admin

# 优雅关闭配置
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# 支持 overseer 零停机重启（如果使用 overseer）
# 使用 systemctl reload goravel-admin 触发零停机重启
ExecReload=/bin/kill -HUP $MAINPID

# 环境变量（可选，如果不在 .env 文件中配置）
# Environment="APP_ENV=production"
# Environment="APP_DEBUG=false"
# Environment="APP_URL=https://your-domain.com"

# 安全设置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/www/goravel-admin/storage

# 资源限制
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

