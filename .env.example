APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# APP_HOST=127.0.0.1
APP_HOST=0.0.0.0
APP_PORT=3008

GRPC_HOST=
GRPC_PORT=


# JWT 配置
JWT_SECRET=
JWT_TTL=600             # Token 有效期（分钟），默认 600 分钟


# 日志配置
LOG_CHANNEL=stack
LOG_LEVEL=debug
# LOG_LEVEL=info

# 缓存配置
CACHE_STORE=redis

# 队列配置
QUEUE_CONNECTION=redis


DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379


# MAIL_HOST=
# MAIL_PORT=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=

# 开发者管理员id
ADMIN_DEVELOPER_IDS=2
