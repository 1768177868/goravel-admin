APP_NAME=Goravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000

GRPC_HOST=
GRPC_PORT=


# JWT 配置
JWT_SECRET=
JWT_TTL=60             # Token 有效期（分钟），默认 60 分钟

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=



# ============================================
# Export Configuration
# ============================================
# 导出文件存储配置
# Export file storage configuration

# 导出目标磁盘 (Export target disk)
# 可选值: local, s3, oss, cos, minio
# 默认: local (存储到本地 storage/app/exports 目录)
# Options: local, s3, oss, cos, minio
# Default: local (stored to storage/app/exports directory)
EXPORT_DISK=local

# 导出文件存储路径 (Export file storage path)
# 相对于磁盘根目录的路径
# 例如: exports 表示存储到 storage/app/exports (本地) 或 s3://bucket/exports (S3)
# Relative path to disk root directory
# Example: exports means storage/app/exports (local) or s3://bucket/exports (S3)
EXPORT_PATH=exports

# 导出文件格式 (Export file format)
# 可选值: csv, xlsx
# 默认: csv
# Options: csv, xlsx
# Default: csv
EXPORT_FORMAT=csv

# 导出文件访问URL前缀 (Export file access URL prefix)
# 用于生成下载链接，如果为空则返回文件路径
# 例如: https://your-bucket.s3.amazonaws.com 或 https://your-domain.com/storage
# Used to generate download links, if empty returns file path
# Example: https://your-bucket.s3.amazonaws.com or https://your-domain.com/storage
EXPORT_URL_PREFIX=

# ============================================
# AWS S3 Configuration (当 EXPORT_DISK=s3 时使用)
# AWS S3 Configuration (Used when EXPORT_DISK=s3)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_ACCESS_KEY_SECRET=
AWS_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# ============================================
# 阿里云 OSS Configuration (当 EXPORT_DISK=oss 时使用)
# Aliyun OSS Configuration (Used when EXPORT_DISK=oss)
# ============================================
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_BUCKET=
ALIYUN_URL=
ALIYUN_ENDPOINT=

# ============================================
# 腾讯云 COS Configuration (当 EXPORT_DISK=cos 时使用)
# Tencent COS Configuration (Used when EXPORT_DISK=cos)
# ============================================
TENCENT_ACCESS_KEY_ID=
TENCENT_ACCESS_KEY_SECRET=
TENCENT_URL=

# ============================================
# MinIO Configuration (当 EXPORT_DISK=minio 时使用)
# MinIO Configuration (Used when EXPORT_DISK=minio)
# ============================================
MINIO_ACCESS_KEY_ID=
MINIO_ACCESS_KEY_SECRET=
MINIO_REGION=us-east-1
MINIO_BUCKET=
MINIO_URL=
MINIO_ENDPOINT=
MINIO_SSL=false